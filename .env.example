# ---------------------------------------------------------------------------------------------
# Crayonlark environment: exactly the variables docker-compose.yml asks for.
# Production: Coolify → your resource → Environment Variables.  Local: `make env` creates .env.
# All secrets and keys live here (env vars), never in the database.
# Fixed settings (domains, database name/user, KDP limit 2+2, SMTP port 587, …) are written in
# docker-compose.yml. The monthly API budget is not a secret and is set in admin → Settings.
# ---------------------------------------------------------------------------------------------

# === REQUIRED: the 7 secrets (scripts/gen-env.sh makes them). Never change them after the
# first deploy: the database and the file storage are locked to them.
SECRET_KEY=                 # openssl rand -hex 32
POSTGRES_PASSWORD=          # openssl rand -hex 16
GARAGE_RPC_SECRET=          # openssl rand -hex 32   (exactly 64 hex chars)
GARAGE_ADMIN_TOKEN=         # openssl rand -hex 24
S3_ACCESS_KEY=              # echo GK$(openssl rand -hex 12)   (GK + 24 hex chars)
S3_SECRET_KEY=              # openssl rand -hex 32   (64 hex chars)
REVALIDATE_SECRET=          # openssl rand -hex 24

# === OPTIONAL: each group switches one feature on. Empty = that feature stays off.

# --- AI (empty = free offline/manual mode). Keys alone change nothing: choose official API or
# OpenRouter per agent in admin → Settings → AI providers. See docs/API_KEYS.md.
ANTHROPIC_API_KEY=          # console.anthropic.com (separate from a Claude Pro subscription)
OPENAI_API_KEY=             # platform.openai.com (separate from ChatGPT Plus)
GEMINI_API_KEY=             # aistudio.google.com (separate from Gemini Pro)
OPENROUTER_API_KEY=         # openrouter.ai/keys: one key for many models
WEBSEARCH_PROVIDER=         # tavily | brave | (empty = off); research agent only
WEBSEARCH_API_KEY=

# --- Telegram: approvals, alerts and the weekly report on your phone
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Email (any SMTP on port 587: Brevo, Resend, SES, Zoho...): free printables, contact
# form, weekly report
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crayonlark <hello@crayonlark.com>   # a sender your SMTP provider has verified
OWNER_EMAIL=                # where the weekly report and contact messages go

# --- Etsy Open API v3. App callback: https://admin.crayonlark.com/api/oauth/etsy/callback
ETSY_API_KEY=               # app "keystring"
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=0          # after connecting: `crayonlark etsy-taxonomy --search coloring`

# --- Pinterest API v5. Redirect URI: https://admin.crayonlark.com/api/oauth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Off-site copy of the nightly backup (any S3-compatible storage: B2, R2, Wasabi...)
BACKUP_S3_ENDPOINT=         # e.g. https://s3.eu-central-003.backblazeb2.com
BACKUP_S3_REGION=           # only if your provider needs one
BACKUP_S3_BUCKET=           # empty = off-site copy off
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# --- Website extras
AMAZON_ASSOCIATES_TAG=      # appended to Amazon links
TURNSTILE_SECRET=           # Cloudflare Turnstile captcha on the contact form (both keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_UMAMI_URL=      # analytics, e.g. https://stats.crayonlark.com (redeploy after setting)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
