# ---------------------------------------------------------------------------------------------
# Crayonlark environment. Copy to .env for local dev (or run `make env` to generate secrets).
# In production set these in Coolify → your resource → Environment Variables.
# Lines marked REQUIRED must be set; everything else is optional.
# ---------------------------------------------------------------------------------------------

# --- REQUIRED secrets (generate with the commands shown) ---
SECRET_KEY=                 # openssl rand -hex 32
POSTGRES_PASSWORD=          # openssl rand -hex 16
GARAGE_RPC_SECRET=          # openssl rand -hex 32   (exactly 64 hex chars)
GARAGE_ADMIN_TOKEN=         # openssl rand -hex 24
S3_ACCESS_KEY=              # echo GK$(openssl rand -hex 12)   (GK + 24 hex chars)
S3_SECRET_KEY=              # openssl rand -hex 32   (64 hex chars)
REVALIDATE_SECRET=          # openssl rand -hex 24

# --- Sites ---
PUBLIC_SITE_URL=https://crayonlark.com
ADMIN_SITE_URL=https://admin.crayonlark.com

# --- Budget guard (all paid API calls) ---
MONTHLY_BUDGET_INR=2000
USD_INR_RATE=88

# --- KDP weekly limits (week resets Sunday 00:00 UTC) ---
KDP_WEEKLY_PAPERBACKS=2
KDP_WEEKLY_HARDCOVERS=2

# --- AI providers (optional; manual/offline mode works without any) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
WEBSEARCH_PROVIDER=         # tavily | brave | (empty = off)
WEBSEARCH_API_KEY=

# --- Telegram (approvals on phone) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Email (any SMTP: Brevo, Resend, SES, Zoho...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crayonlark <hello@crayonlark.com>
OWNER_EMAIL=

# --- Etsy Open API v3 ---
ETSY_API_KEY=               # app "keystring"
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=0          # taxonomy id for printable coloring pages

# --- Pinterest API v5 ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Website ---
AMAZON_ASSOCIATES_TAG=      # optional, appended to Amazon links
TURNSTILE_SECRET=           # optional Cloudflare Turnstile for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_UMAMI_URL=      # optional, e.g. https://stats.crayonlark.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Workers ---
UPSCALE_ENABLED=false
BACKUP_RETENTION_DAYS=14
