# ---------------------------------------------------------------------------------------------
# Crayonlark environment. Copy to .env for local dev (or run `make env` to generate secrets).
# In production set these in Coolify → your resource → Environment Variables.
# Lines marked REQUIRED must be set; everything else is optional.
# ---------------------------------------------------------------------------------------------

# --- REQUIRED secrets (generate with the commands shown) ---
SECRET_KEY=                 # openssl rand -hex 32
POSTGRES_PASSWORD=          # openssl rand -hex 16
GARAGE_RPC_SECRET=          # openssl rand -hex 32   (exactly 64 hex chars)
GARAGE_ADMIN_TOKEN=         # openssl rand -hex 24
S3_ACCESS_KEY=              # echo GK$(openssl rand -hex 12)   (GK + 24 hex chars)
S3_SECRET_KEY=              # openssl rand -hex 32   (64 hex chars)
REVALIDATE_SECRET=          # openssl rand -hex 24

# --- Sites ---
PUBLIC_SITE_URL=https://crayonlark.com
ADMIN_SITE_URL=https://admin.crayonlark.com

# --- Budget guard (all paid API calls) ---
MONTHLY_BUDGET_INR=2000
USD_INR_RATE=88

# --- KDP weekly limits (week resets Sunday 00:00 UTC) ---
KDP_WEEKLY_PAPERBACKS=2
KDP_WEEKLY_HARDCOVERS=2

# --- AI providers (optional; manual/offline mode works without any) ---
# Keys alone change nothing: pick provider + model per agent in admin → Settings → AI providers.
# Every paid call is counted against MONTHLY_BUDGET_INR. See docs/API_KEYS.md.
ANTHROPIC_API_KEY=          # console.anthropic.com (separate from a Claude Pro subscription)
OPENAI_API_KEY=             # platform.openai.com (separate from ChatGPT Plus)
GEMINI_API_KEY=             # aistudio.google.com (separate from Gemini Pro)
WEBSEARCH_PROVIDER=         # tavily | brave | (empty = off); used only by the research agent
WEBSEARCH_API_KEY=

# --- Telegram (approvals on phone) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Email (any SMTP: Brevo, Resend, SES, Zoho...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Crayonlark <hello@crayonlark.com>
OWNER_EMAIL=

# --- Etsy Open API v3 ---
# Register the app at https://www.etsy.com/developers with callback URL
#   https://admin.crayonlark.com/api/oauth/etsy/callback   (ADMIN_SITE_URL + that path)
ETSY_API_KEY=               # app "keystring"
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=0          # after connecting: `crayonlark etsy-taxonomy coloring`
ETSY_WHEN_MADE=2020_2026    # Etsy "when made" value for new listings

# --- Pinterest API v5 ---
# Redirect URI in the Pinterest app: https://admin.crayonlark.com/api/oauth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Website ---
AMAZON_ASSOCIATES_TAG=      # optional, appended to Amazon links
TURNSTILE_SECRET=           # optional Cloudflare Turnstile for contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_UMAMI_URL=      # optional, e.g. https://stats.crayonlark.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Workers ---
UPSCALE_ENABLED=false
BACKUP_RETENTION_DAYS=14
